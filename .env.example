# --- Public site / EasyPanel ---
# Set these in EasyPanel → Environment before (re)building so Next.js can inline NEXT_PUBLIC_*.

# Backend API base URL (no trailing slash). Quote form POSTs to {URL}/api/inquiries
NEXT_PUBLIC_API_URL=https://api.example.com

# Canonical public site URL (no trailing slash) — used for sitemap, Open Graph, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.globmoro.com

# Contact channels (E.164 preferred). Fallbacks are owner-approved brochure numbers.
NEXT_PUBLIC_WHATSAPP=+491637726127
NEXT_PUBLIC_PHONE=+212706503606
NEXT_PUBLIC_EMAIL=Globmoro@gmail.com

# Runtime listen port (EasyPanel usually injects PORT automatically)
PORT=3000
